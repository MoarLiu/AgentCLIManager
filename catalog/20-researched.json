    {
      "id": "gemini-cli",
      "name": "Gemini CLI",
      "vendor": "Google",
      "homepage": "https://github.com/google-gemini/gemini-cli",
      "kind": "cli",
      "binaries": [
        "gemini"
      ],
      "packages": [
        "@google/gemini-cli",
        "gemini-cli"
      ],
      "paths": [
        {
          "path": "~/.gemini",
          "kind": "data"
        },
        {
          "path": "~/.gemini/bin",
          "kind": "program"
        },
        {
          "path": "~/.gemini/settings.json",
          "kind": "config"
        },
        {
          "path": "~/.gemini/GEMINI.md",
          "kind": "data"
        },
        {
          "path": "~/.gemini/tmp",
          "kind": "data"
        },
        {
          "path": "~/.gemini/installation_id",
          "kind": "data"
        },
        {
          "path": "~/.gemini/oauth_creds.json",
          "kind": "credentials"
        },
        {
          "path": "~/.gemini/google_accounts.json",
          "kind": "credentials"
        },
        {
          "path": "~/.gemini/mcp-oauth-tokens.json",
          "kind": "credentials"
        },
        {
          "path": "~/.gemini/a2a-oauth-tokens.json",
          "kind": "credentials"
        }
      ],
      "install": [
        {
          "channel": "npm",
          "command": "npm install -g @google/gemini-cli"
        },
        {
          "channel": "brew",
          "command": "brew install gemini-cli"
        },
        {
          "channel": "other",
          "command": "sudo port install gemini-cli"
        }
      ],
      "uninstallCommand": "npm uninstall -g @google/gemini-cli",
      "docs": "https://geminicli.com/docs/resources/uninstall"
    },
